# apmond 2.x configuration - use the SAME settings on every node.
#
# apmon_seed (not set here): the shared passphrase, identical on every node.
# While it is not set, a built-in default passphrase is used so apmond works out of the box,
# but it gives no real protection. apmond logs a notice at start and every 6 hours while the
# default is in use. To set your own, on every node:
#   uci set apmond.setup.apmon_seed='<your passphrase>'; uci commit apmond; service apmond restart

config apmond 'setup'
	option enabled '1'
	# Optional - built-in defaults shown
	#option port '2468'                    # TCP port of the collector; must be the same on every node
	#option role 'auto'                    # auto, collector or sender
	                                        # auto: default route via 'device' = sender, otherwise collector
	#option collector ''                   # sender: collector address; empty = the default gateway
	#option interval '30'                  # seconds between reports (10-3600)
	#option startup_delay '10'             # seconds before the first report
	#option device 'br-lan'                # its MAC identifies this node; its bridge fdb gives wired clients
	#option key_epoch '0'                  # change on every node together with a new apmon_seed
	#option max_age '120'                  # collector: accepted clock difference in seconds
	#option client_stale_timeout '600'     # collector: keep a client that dropped out as stale this long
	#option max_message_size '262144'      # collector: largest accepted message in bytes
	#option debuglevel '1'                 # 0 errors, 1 notices, 2 info, 3 debug
